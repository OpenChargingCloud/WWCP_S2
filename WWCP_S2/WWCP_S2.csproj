<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>cloud.charging.open.protocols.S2</RootNamespace>
    <AssemblyName>cloud.charging.open.protocols.S2</AssemblyName>
    <PackageId>cloud.charging.open.protocols.S2</PackageId>
    <Version>0.1.0</Version>
    <Description>An implementation of the S2 energy flexibility standard (EN 50491-12-2, S2 JSON v1.0.0) and S2 Connect 1.0.0 for .NET, built on the Vanaheimr Styx and Hermod libraries.</Description>
    <PackageTags>S2;S2Connect;EN50491-12-2;energy;flexibility;CEM;RM;WWCP;OpenChargingCloud</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See CHANGELOG.md at https://github.com/OpenChargingCloud/WWCP_S2/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <EnablePackageValidation>true</EnablePackageValidation>

    <!-- A separate symbol package, and source served from GitHub: the SDK adds SourceLink for a
         GitHub repository by itself since .NET 8, it only needs the repository URL published and
         the generated files embedded. Together with Deterministic + ContinuousIntegrationBuild
         (Directory.Build.props) a package built by CI can be stepped into and re-created. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <!-- The normative S2 JSON schemas (v1.0.0) and S2 Connect OpenAPI files (v1.0), Apache-2.0,
         see THIRD-PARTY-NOTICES.md. Embedded for schema-validation tests and diagnostics. -->
    <EmbeddedResource Include="Schemas\**\*.json;Schemas\**\*.yml" />
    <!-- Forward slashes rather than the "\" of most NuGet examples: a backslash is a legal file
         name character on Linux, so PackagePath="\" can land the readme beside the package root
         instead of in it, and PackageReadmeFile then has nothing to point at. "/" means the root
         on both platforms. The CI packages on the Debian leg and checks the layout of the produced
         package, so this cannot regress silently. -->
    <None Include="..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cryptographically insecure random helpers and URL-safe Base64 are banned, see BannedSymbols.txt. -->
    <AdditionalFiles Include="BannedSymbols.txt" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Styx and Hermod are sibling source projects (PLAN.md D4/D12), and neither is published on
      nuget.org. Left alone, `dotnet pack` turns a ProjectReference into a package dependency and
      infers id and version from the project: "org.GraphDefined.Vanaheimr.Hermod 1.0.0", which does
      not exist, and "Styx 1.0.0" — an id that on nuget.org belongs to an unrelated WebSocket
      library by ReactiveMarkets. A consumer restoring that package would fail today and could pull
      a stranger's assembly the day that version appears.

      PrivateAssets=all keeps both out of the .nuspec. The package therefore declares only the
      dependencies it can honestly name, and buildTransitive/*.targets tells anyone who installs it
      which two assemblies they have to supply themselves — see build/ and README "Building".
      The price is that the reference no longer flows to consuming projects, which is why
      WWCP_S2Tests and WWCP_S2_Samples reference Styx and Hermod themselves; they use both directly
      anyway. Once Vanaheimr publishes the two libraries, drop PrivateAssets and the .targets file.
    -->
    <ProjectReference Include="..\..\Hermod\Hermod\Hermod.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\Styx\Styx\Styx.csproj"       PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ships as buildTransitive so it also runs for projects that get this package transitively. -->
    <None Include="build\cloud.charging.open.protocols.S2.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="cloud.charging.open.protocols.S2.Tests" />
  </ItemGroup>

</Project>
